# Public, canonical URL of the deployed site (used for metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: endpoint for a live "Ask My AI" backend.
# When unset, the assistant runs in clearly-labelled demo mode using local retrieval.
# The endpoint must accept POST { "question": string } and return { "answer": string, "sources"?: string[] }.
NEXT_PUBLIC_ASSISTANT_ENDPOINT=
